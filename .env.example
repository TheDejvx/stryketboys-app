# MongoDB Atlas connection string (use stryk_app database)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stryk_app?retryWrites=true&w=majority

# Gemini API key (from aistudio.google.com), used to decode uploaded coupon screenshots
GEMINI_API_KEY=AIza...

# Server port (Railway sets this automatically)
PORT=5003
